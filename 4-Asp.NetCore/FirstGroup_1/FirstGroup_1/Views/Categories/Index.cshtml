@{
    ViewData["Title"] = "Categories Mangment";
}
@model List<Category>

<h1>Categories Infromation</h1>

<a asp-action="Create" class="btn btn-success">Add New Category</a>

<br />
<br />

<table class="table table-bordered">
    <thead>
        <tr>
            <th>#</th>
            <th>Name</th>
            <th>Description</th>
            <th>Controls</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var cat in Model)
        {
            <tr>
                <td>@cat.Id</td>
                <td>@cat.Name</td>
                <td>@cat.Description</td>
                <td>
                    <a class="btn btn-secondary" asp-action="Details" asp-route-Id="@cat.Id">Details</a>
                    <a class="btn btn-warning" asp-action="Update" asp-route-Id="@cat.Id">Update</a>
                    <a class="btn btn-danger" asp-action="Delete" asp-route-Id="@cat.Id">Delete</a>
                </td>
            </tr>

        }
</table>

