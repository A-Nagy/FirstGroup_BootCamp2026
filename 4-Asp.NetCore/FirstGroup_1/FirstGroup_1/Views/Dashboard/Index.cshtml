
@{
    ViewData["Title"] = "Dashboard";
}

<h1>Welecome , @User.Identity?.Name</h1>
<hr />

<div class="row">
@if (User.HasClaim(PermissionsNames.ClaimType, PermissionsNames.EmployeeView))
    {
        <div class="col-md-4 mb-3">
            <div class="card">
                <div class="card-body">
                    <h4 class="card-title">Employees List</h4>
                    <p>view and Mange Employees According to your Permissions</p>
                    <a asp-controller="Employees" asp-action="Index" class="btn btn-primary"> Employees </a>
                </div>
            </div>
        </div>
    }
    @if (User.HasClaim(PermissionsNames.ClaimType, PermissionsNames.DepartmentView))
    {
        <div class="col-md-4 mb-3">
            <div class="card">
                <div class="card-body">
                    <h4 class="card-title">Departments List</h4>
                    <p>view and Mange Departments According to your Permissions</p>
                    <a asp-controller="Employees" asp-action="Index" class="btn btn-primary"> Departments </a>
                </div>
            </div>
        </div>
    }
