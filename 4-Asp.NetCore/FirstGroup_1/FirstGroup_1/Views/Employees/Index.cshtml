@{
    ViewData["Title"] = "Employees Mangment";
}
@model List<Employee>

<h1>Employees Infromation</h1>
@if (User.HasClaim(PermissionsNames.ClaimType, PermissionsNames.EmployeeCreate))
{
    <a asp-action="Create" class="btn btn-success">Add New Employee</a>
}


<br />
<br />

<table class="table table-bordered">
    <thead>
        <tr>
            <th>#</th>
            <th>Name</th>
            <th>Address</th>
            <th>Salary</th>
            <th>City</th>
            <th>Phone</th>
            <th>Email</th>
            <th>Department</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var employee in Model)
        {
            <tr>
                <td>@employee.Id</td>
                <td>@employee.Name</td>
                <td>@employee.Address</td>
                <td>@employee.Salary</td>
                <td>@employee.City</td>
                <td>@employee.Phone</td>
                <td>@employee.Email</td>
                <td>@employee.Department?.Name</td>
                <td>
                    @if (User.HasClaim(PermissionsNames.ClaimType, PermissionsNames.EmployeeEdit))
                    {
                        <a class="btn btn-warning" asp-action="Update" asp-route-Id="@employee.Id">Update</a>
                    }
                    @if (User.HasClaim(PermissionsNames.ClaimType, PermissionsNames.EmployeeDelete))
                    {
                        <a class="btn btn-danger" asp-action="Delete" asp-route-Id="@employee.Id">Delete</a>
                    }
                    @if (User.HasClaim(PermissionsNames.ClaimType, PermissionsNames.EmployeeDetails))
                    {
                        <a class="btn btn-secondary" asp-action="Details" asp-route-Id="@employee.Id">Details</a>
                    }
                </td>
            </tr>

        }
</table>

